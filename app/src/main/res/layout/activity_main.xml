<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Barre d'onglets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:padding="4dp"
        android:elevation="4dp">
        
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
        
        <TextView
            android:id="@+id/newTabBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textSize="22sp"
            android:textColor="@color/primary"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="nouvelOnglet"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐍 ViperBrowser"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rapide - Securise - Moderne"
                android:textSize="14sp"
                android:textColor="@color/textSecondary"
                android:layout_marginBottom="36dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card"
                android:orientation="horizontal"
                android:padding="4dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="36dp"
                android:elevation="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔍" android:textSize="20sp" android:paddingStart="16dp"/>
                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Rechercher ou entrer une URL..."
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textMuted"
                    android:paddingVertical="16dp"
                    android:inputType="textUri"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:textSize="16sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="➜" android:textSize="22sp" android:textColor="@color/primary" android:padding="12dp" android:clickable="true" android:onClick="validerRecherche"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sites populaires" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/textPrimary" android:layout_marginBottom="16dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/card" android:layout_margin="6dp" android:paddingVertical="24dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:onClick="openGoogle">
                    <TextView android:text="🔍" android:textSize="32sp"/>
                    <TextView android:text="Google" android:textColor="@color/textPrimary" android:textSize="14sp" android:layout_marginTop="10dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/card" android:layout_margin="6dp" android:paddingVertical="24dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:onClick="openYouTube">
                    <TextView android:text="▶️" android:textSize="32sp"/>
                    <TextView android:text="YouTube" android:textColor="@color/textPrimary" android:textSize="14sp" android:layout_marginTop="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="28dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/card" android:layout_margin="6dp" android:paddingVertical="24dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:onClick="openInstagram">
                    <TextView android:text="📸" android:textSize="32sp"/>
                    <TextView android:text="Instagram" android:textColor="@color/textPrimary" android:textSize="14sp" android:layout_marginTop="10dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/card" android:layout_margin="6dp" android:paddingVertical="24dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:onClick="openReddit">
                    <TextView android:text="🤖" android:textSize="32sp"/>
                    <TextView android:text="Reddit" android:textColor="@color/textPrimary" android:textSize="14sp" android:layout_marginTop="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginBottom="20dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fonctions rapides" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/textPrimary" android:layout_marginBottom="16dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="4" android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="toggleAdBlock" android:paddingVertical="16dp" android:clickable="true">
                    <TextView android:text="🛡️" android:textSize="24sp"/>
                    <TextView android:text="AdBlock" android:textColor="@color/textSecondary" android:textSize="11sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="traduirePage" android:paddingVertical="16dp" android:clickable="true">
                    <TextView android:text="🌐" android:textSize="24sp"/>
                    <TextView android:text="Traduire" android:textColor="@color/textSecondary" android:textSize="11sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="openFavorites" android:paddingVertical="16dp" android:clickable="true">
                    <TextView android:text="⭐" android:textSize="24sp"/>
                    <TextView android:text="Favoris" android:textColor="@color/textSecondary" android:textSize="11sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="openHistory" android:paddingVertical="16dp" android:clickable="true">
                    <TextView android:text="📜" android:textSize="24sp"/>
                    <TextView android:text="Historique" android:textColor="@color/textSecondary" android:textSize="11sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:text="ViperBrowser v3.0" android:textSize="11sp" android:textColor="@color/textMuted" android:layout_marginTop="8dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Barre de navigation inférieure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navBar"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:elevation="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="retourAccueil">
            <TextView android:text="🏠" android:textSize="22sp"/>
            <TextView android:text="Accueil" android:textColor="@color/navActive" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="toutTelecharger">
            <TextView android:text="📥" android:textSize="22sp"/>
            <TextView android:text="Videos" android:textColor="@color/navInactive" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="modePiP">
            <TextView android:text="🖼️" android:textSize="22sp"/>
            <TextView android:text="PiP" android:textColor="@color/navInactive" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="lectureArrierePlan">
            <TextView android:text="🎵" android:textSize="22sp"/>
            <TextView android:text="Arriere-plan" android:textColor="@color/navInactive" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="openSettings">
            <TextView android:text="⚙️" android:textSize="22sp"/>
            <TextView android:text="Parametres" android:textColor="@color/navInactive" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
