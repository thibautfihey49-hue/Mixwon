<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Barre d'onglets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        android:orientation="horizontal"
        android:padding="4dp"
        android:elevation="4dp">
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
        <TextView
            android:id="@+id/newTabBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textSize="22sp"
            android:textColor="#7B61FF"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="nouvelOnglet"/>
    </LinearLayout>

    <!-- Contenu principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ViperBrowser"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="#7B61FF"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rapide - Securise - Moderne"
                android:textSize="14sp"
                android:textColor="#B0B0C0"
                android:layout_marginBottom="36dp"/>

            <!-- Barre de recherche -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#252538"
                android:orientation="horizontal"
                android:padding="4dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="36dp"
                android:elevation="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="20sp"
                    android:paddingStart="16dp"/>
                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#00000000"
                    android:hint="Rechercher ou entrer une URL..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#707088"
                    android:paddingVertical="16dp"
                    android:inputType="textUri"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➜"
                    android:textSize="22sp"
                    android:textColor="#7B61FF"
                    android:padding="12dp"
                    android:clickable="true"
                    android:onClick="validerRecherche"/>
            </LinearLayout>

            <!-- Sites populaires -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sites populaires"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252538"
                    android:layout_margin="6dp"
                    android:paddingVertical="24dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:onClick="openGoogle">
                    <TextView android:text="🔍" android:textSize="32sp"/>
                    <TextView android:text="Google" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252538"
                    android:layout_margin="6dp"
                    android:paddingVertical="24dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:onClick="openYouTube">
                    <TextView android:text="▶️" android:textSize="32sp"/>
                    <TextView android:text="YouTube" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252538"
                    android:layout_margin="6dp"
                    android:paddingVertical="24dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:onClick="openInstagram">
                    <TextView android:text="📸" android:textSize="32sp"/>
                    <TextView android:text="Instagram" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252538"
                    android:layout_margin="6dp"
                    android:paddingVertical="24dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:onClick="openReddit">
                    <TextView android:text="🤖" android:textSize="32sp"/>
                    <TextView android:text="Reddit" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Ligne de separation -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A3A5C"
                android:layout_marginBottom="20dp"/>

            <!-- Fonctions rapides -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fonctions rapides"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:onClick="toggleAdBlock"
                    android:paddingVertical="16dp"
                    android:clickable="true">
                    <TextView android:text="🛡️" android:textSize="24sp"/>
                    <TextView android:text="AdBlock" android:textColor="#B0B0C0" android:textSize="11sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:onClick="traduirePage"
                    android:paddingVertical="16dp"
                    android:clickable="true">
                    <TextView android:text="🌐" android:textSize="24sp"/>
                    <TextView android:text="Traduire" android:textColor="#B0B0C0" android:textSize="11sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:onClick="openFavorites"
                    android:paddingVertical="16dp"
                    android:clickable="true">
                    <TextView android:text="⭐" android:textSize="24sp"/>
                    <TextView android:text="Favoris" android:textColor="#B0B0C0" android:textSize="11sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:onClick="openHistory"
                    android:paddingVertical="16dp"
                    android:clickable="true">
                    <TextView android:text="📜" android:textSize="24sp"/>
                    <TextView android:text="Historique" android:textColor="#B0B0C0" android:textSize="11sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:text="ViperBrowser v3.0"
                android:textSize="11sp"
                android:textColor="#707088"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Barre de navigation inferieure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#181828"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:elevation="16dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:onClick="retourAccueil">
            <TextView android:text="🏠" android:textSize="22sp"/>
            <TextView android:text="Accueil" android:textColor="#7B61FF" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:onClick="toutTelecharger">
            <TextView android:text="📥" android:textSize="22sp"/>
            <TextView android:text="Videos" android:textColor="#8888A0" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:onClick="modePiP">
            <TextView android:text="🖼️" android:textSize="22sp"/>
            <TextView android:text="PiP" android:textColor="#8888A0" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:onClick="lectureArrierePlan">
            <TextView android:text="🎵" android:textSize="22sp"/>
            <TextView android:text="Arriere-plan" android:textColor="#8888A0" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:onClick="openSettings">
            <TextView android:text="⚙️" android:textSize="22sp"/>
            <TextView android:text="Parametres" android:textColor="#8888A0" android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
