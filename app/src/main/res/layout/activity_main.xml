<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ViperBrowser"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnBackground"
        android:layout_marginTop="52dp"
        android:layout_marginBottom="8dp"/>
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rapide • Sécurisé • Moderne"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="40dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:shapeAppearance="@style/ShapeAppearance_Viper_Large"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        android:layout_marginBottom="44dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="22sp"
                android:padding="16dp"/>
            <EditText
                android:id="@+id/searchBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Rechercher ou entrer une URL..."
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:paddingVertical="18dp"
                android:inputType="textUri"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:textSize="16sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sites populaires"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnBackground"
        android:layout_marginBottom="20dp"
        android:paddingStart="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginBottom="40dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:shapeAppearance="@style/ShapeAppearance_Viper_Medium"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openGoogle">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="24dp">
                <TextView android:text="🔍" android:textSize="28sp" android:layout_marginBottom="10dp"/>
                <TextView android:text="Google" android:textColor="?attr/colorOnSurface" android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:shapeAppearance="@style/ShapeAppearance_Viper_Medium"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openYouTube">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="24dp">
                <TextView android:text="▶️" android:textSize="28sp" android:layout_marginBottom="10dp"/>
                <TextView android:text="YouTube" android:textColor="?attr/colorOnSurface" android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:shapeAppearance="@style/ShapeAppearance_Viper_Medium"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openInstagram">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="24dp">
                <TextView android:text="📸" android:textSize="28sp" android:layout_marginBottom="10dp"/>
                <TextView android:text="Instagram" android:textColor="?attr/colorOnSurface" android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:shapeAppearance="@style/ShapeAppearance_Viper_Medium"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openReddit">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="24dp">
                <TextView android:text="🤖" android:textSize="28sp" android:layout_marginBottom="10dp"/>
                <TextView android:text="Reddit" android:textColor="?attr/colorOnSurface" android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Outils"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnBackground"
        android:layout_marginBottom="20dp"
        android:paddingStart="4dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="4" android:layout_marginBottom="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="toggleAdBlock" android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
            <TextView android:text="🛡️" android:textSize="24sp" android:layout_marginBottom="8dp"/>
            <TextView android:text="AdBlock" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="openIncognito" android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
            <TextView android:text="🕵️" android:textSize="24sp" android:layout_marginBottom="8dp"/>
            <TextView android:text="Incognito" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="toggleNightMode" android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
            <TextView android:text="🌙" android:textSize="24sp" android:layout_marginBottom="8dp"/>
            <TextView android:text="Mode Nuit" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="toggleDataSaving" android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
            <TextView android:text="⚡" android:textSize="24sp" android:layout_marginBottom="8dp"/>
            <TextView android:text="Éco" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="4">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="openFavorites" android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
            <TextView android:text="⭐" android:textSize="24sp" android:layout_marginBottom="8dp"/>
            <TextView android:text="Favoris" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="toggleAutoClear" android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
            <TextView android:text="🧹" android:textSize="24sp" android:layout_marginBottom="8dp"/>
            <TextView android:text="Auto-Clear" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="effacerTout" android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
            <TextView android:text="🗑️" android:textSize="24sp" android:layout_marginBottom="8dp"/>
            <TextView android:text="Effacer" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:onClick="openSettings" android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
            <TextView android:text="⚙️" android:textSize="24sp" android:layout_marginBottom="8dp"/>
            <TextView android:text="Paramètres" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ViperBrowser v1.0 — Material 3 MAX"
        android:textSize="12sp"
        android:textColor="?attr/colorOutline"
        android:layout_marginTop="8dp"/>
</LinearLayout>
