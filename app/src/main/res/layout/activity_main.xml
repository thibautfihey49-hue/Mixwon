<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:orientation="vertical">

    <!-- BARRE D'ONGLETS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        android:orientation="horizontal"
        android:padding="4dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/newTabBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textSize="22sp"
            android:textColor="#7B61FF"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="nouvelOnglet"/>
    </LinearLayout>

    <!-- CONTENU PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ViperBrowser"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#7B61FF"
                android:layout_marginBottom="5dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rapide - Securise - Moderne"
                android:textSize="14sp"
                android:textColor="#B0B0C0"
                android:layout_marginBottom="30dp"/>

            <!-- BARRE DE RECHERCHE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#252538"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="30dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="20sp"
                    android:padding="10dp"/>
                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Rechercher ou entrer une URL..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#707088"
                    android:padding="15dp"
                    android:inputType="textUri"
                    android:maxLines="1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➜"
                    android:textSize="20sp"
                    android:textColor="#7B61FF"
                    android:padding="10dp"
                    android:clickable="true"
                    android:onClick="validerRecherche"/>
            </LinearLayout>

            <!-- SITES POPULAIRES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sites populaires"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="15dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252538"
                    android:layout_margin="5dp"
                    android:padding="20dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:text="🔍" android:textSize="30sp"/>
                    <TextView android:text="Google" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="8dp"
                        android:clickable="true" android:onClick="openGoogle"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252538"
                    android:layout_margin="5dp"
                    android:padding="20dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:text="▶️" android:textSize="30sp"/>
                    <TextView android:text="YouTube" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="8dp"
                        android:clickable="true" android:onClick="openYouTube"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252538"
                    android:layout_margin="5dp"
                    android:padding="20dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:text="📸" android:textSize="30sp"/>
                    <TextView android:text="Instagram" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="8dp"
                        android:clickable="true" android:onClick="openInstagram"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252538"
                    android:layout_margin="5dp"
                    android:padding="20dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:text="🤖" android:textSize="30sp"/>
                    <TextView android:text="Reddit" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="8dp"
                        android:clickable="true" android:onClick="openReddit"/>
                </LinearLayout>
            </LinearLayout>

            <!-- SEPARATEUR -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A3A5C"
                android:layout_marginVertical="20dp"/>

            <!-- FONCTIONS RAPIDES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fonctions rapides"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="15dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView android:text="🛡️" android:textSize="22sp"/>
                    <TextView android:text="AdBlock" android:textColor="#B0B0C0" android:textSize="11sp" android:layout_marginTop="3dp"
                        android:clickable="true" android:onClick="toggleAdBlock"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView android:text="🌐" android:textSize="22sp"/>
                    <TextView android:text="Traduire" android:textColor="#B0B0C0" android:textSize="11sp" android:layout_marginTop="3dp"
                        android:clickable="true" android:onClick="traduirePage"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView android:text="⭐" android:textSize="22sp"/>
                    <TextView android:text="Favoris" android:textColor="#B0B0C0" android:textSize="11sp" android:layout_marginTop="3dp"
                        android:clickable="true" android:onClick="openFavorites"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView android:text="📜" android:textSize="22sp"/>
                    <TextView android:text="Historique" android:textColor="#B0B0C0" android:textSize="11sp" android:layout_marginTop="3dp"
                        android:clickable="true" android:onClick="openHistory"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:text="ViperBrowser v3.0"
                android:textSize="11sp"
                android:textColor="#707088"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- BARRE DE NAVIGATION EN BAS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#181828"
        android:orientation="horizontal"
        android:padding="5dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">
            <TextView android:text="🏠" android:textSize="20sp"
                android:clickable="true" android:onClick="retourAccueil"/>
            <TextView android:text="Accueil" android:textColor="#7B61FF" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">
            <TextView android:text="📥" android:textSize="20sp"
                android:clickable="true" android:onClick="toutTelecharger"/>
            <TextView android:text="Videos" android:textColor="#8888A0" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">
            <TextView android:text="🖼️" android:textSize="20sp"
                android:clickable="true" android:onClick="modePiP"/>
            <TextView android:text="PiP" android:textColor="#8888A0" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">
            <TextView android:text="🎵" android:textSize="20sp"
                android:clickable="true" android:onClick="lectureArrierePlan"/>
            <TextView android:text="Arriere-plan" android:textColor="#8888A0" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">
            <TextView android:text="⚙️" android:textSize="20sp"
                android:clickable="true" android:onClick="openSettings"/>
            <TextView android:text="Parametres" android:textColor="#8888A0" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
