<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:orientation="vertical">

    <!-- Barre d'adresse -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        android:elevation="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◀" android:textSize="20sp" android:padding="8dp" android:clickable="true" android:onClick="precedent"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" android:textSize="20sp" android:padding="8dp" android:clickable="true" android:onClick="suivant"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻" android:textSize="20sp" android:padding="8dp" android:clickable="true" android:onClick="actualiser"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:id="@+id/urlAffichage" android:text="" android:textSize="13sp" android:textColor="#B0B0C0" android:padding="8dp" android:ellipsize="middle"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="20sp" android:padding="8dp" android:clickable="true" android:onClick="retourAccueil"/>
    </LinearLayout>

    <!-- Contenu Web -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
